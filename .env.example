# Google AI Studio API キー
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter API キー
OPENROUTER_API_KEY=

# Google Translate API キー（サーバー専用 — NEXT_PUBLIC_ を付けないこと）
GOOGLE_TRANSLATE_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cross-app navigation
NEXT_PUBLIC_LINGUAGYM_URL=

# Google Auth — クッキーをサブドメイン間で共有するための親ドメイン
# ローカル開発では未設定のままにすること（localhost は共有不要）
# 本番例: NEXT_PUBLIC_COOKIE_DOMAIN=.pekobit.com
NEXT_PUBLIC_COOKIE_DOMAIN=
